{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/sync-check.sh\"",
            "statusMessage": "Checking for upstream changes",
            "additionalContextLimit": 8000
          }
        ]
      }
    ]
  }
}
