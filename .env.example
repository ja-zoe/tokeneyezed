# Copy to .env and fill in. Never commit .env.

# Atlas Hackathon Sandbox connection string (used by the harness and by mongosh)
MONGODB_URI=
# Optional: database name (defaults to tokeneyezed)
# TOKENEYEZED_DB=tokeneyezed

# OpenRouter key for planner / compactor / model-based observer calls (code arrives 10:30)
OPENROUTER_API_KEY=
# Optional: model for the compactor's summaries (separate from TOKENEYEZED_MODEL, which pins the
# coding agent). Default: anthropic/claude-haiku-4.5
# COMPACTOR_MODEL=
# Optional: new attempts to wait for before writing a memory summary (default 3)
# COMPACT_MIN_ATTEMPTS=3

# Voyage AI key for embeddings (we call the Voyage API directly)
VOYAGE_API_KEY=

# Pinned models live in configs/base.toml ([models], one per agent), not here: one source of
# truth for B, H, and H-mem (invariant I7).

# Claude runner (machine-specific paths; see docs/specs/claude-runner.md)
# The task repo the agent works in: a git repo OUTSIDE this harness repo (invariant I2)
TOKENEYEZED_WORKSPACE=
# Where `tokeneyezed split` writes the hidden validation/heldout splits and their manifest;
# must be unreachable from the workspace (invariant I1). Default: ~/.tokeneyezed/splits
# TOKENEYEZED_SPLITS_DIR=
# Where transcripts, per-attempt hook settings, and spools go (default ~/.tokeneyezed/runs)
# TOKENEYEZED_RUNS_DIR=
# The agent's dedicated Claude Code config dir; log in there once (default ~/.claude-tokeneyezed):
#   CLAUDE_CONFIG_DIR=~/.claude-tokeneyezed claude
# TOKENEYEZED_CLAUDE_CONFIG_DIR=
# The Codex agent's dedicated CODEX_HOME; create and log in once (default ~/.codex-tokeneyezed):
#   mkdir -p ~/.codex-tokeneyezed && CODEX_HOME=~/.codex-tokeneyezed codex login
# TOKENEYEZED_CODEX_HOME=
# Observer service (Dharshan's) the hook shim talks to; the token must match the service's
# TOKENEYEZED_OBSERVER_URL=http://127.0.0.1:8765/event
TOKENEYEZED_OBSERVER_TOKEN=
# The observer service's --audit-log; the Codex runner reads blocked calls from it
# TOKENEYEZED_OBSERVER_AUDIT_LOG=

# Optional client-side guards for the embed() helper (defaults shown; Tier 1 voyage-4 is 8M TPM / 2000 RPM)
# VOYAGE_MAX_RPM=1000
# VOYAGE_MAX_TPM=4000000
# Total tokens this process may spend before embeddings stop (writes then skip `embedding`)
# VOYAGE_TOKEN_BUDGET=50000000
