# Copy to .env and fill in. Never commit .env.

# Atlas Hackathon Sandbox connection string (used by the harness and by mongosh)
MONGODB_URI=

# OpenRouter key for planner / compactor / model-based observer calls (code arrives 10:30)
OPENROUTER_API_KEY=

# Voyage AI key for embeddings (we call the Voyage API directly)
VOYAGE_API_KEY=

# Pinned model for B, H, and H-mem (must be identical across runs)
TOKENEYEZED_MODEL=
